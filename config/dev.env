# CAP-48 — Dev environment settings
# Settings only — no secret values. DB_SECRET_REF is a pointer, not a password.

APP_ENV=dev
APP_VERSION=
LOG_LEVEL=DEBUG

DB_URL=jdbc:mysql://cap48-dev-db.cxysuyiieybt.ap-south-1.rds.amazonaws.com:3306/app_dev?createDatabaseIfNotExist=true
