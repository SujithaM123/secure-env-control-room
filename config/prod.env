# CAP-48 — Prod environment settings
# Settings only — no secret values. DB_SECRET_REF is a pointer, not a password.
# Prod must never use DEBUG logging (enforced by the config-validation script).

APP_ENV=prod
APP_VERSION=
LOG_LEVEL=WARN

DB_URL=jdbc:mysql://cap48-test-db.cxysuyiieybt.ap-south-1.rds.amazonaws.com:3306/app_prod?createDatabaseIfNotExist=true
DB_USERNAME=app_prod_user
DB_SECRET_REF=prod/app/db-password

AUDIT_DB_URL=jdbc:mysql://cap48-test-db.cxysuyiieybt.ap-south-1.rds.amazonaws.com:3306/cap48_audit?createDatabaseIfNotExist=true
AUDIT_DB_USERNAME=cap48_audit_user
AUDIT_DB_SECRET_REF=shared/app/audit-db-password

WRITE_API_KEY_SECRET_REF=prod/app/write-api-key

SECRETS_PROVIDER=aws
