# CAP-48 — Prod environment settings
# Settings only — no secret values. DB_SECRET_REF is a pointer, not a password.
# Prod must never use DEBUG logging (enforced by the config-validation script).

APP_ENV=prod
APP_VERSION=
LOG_LEVEL=WARN

DB_URL=jdbc:postgresql://prod-db.cap48.internal:5432/app_prod
DB_USERNAME=app_prod_user
DB_SECRET_REF=/prod/app/db-password

SECRETS_PROVIDER=aws
